@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userName = HttpContextAccessor.HttpContext?.Session.GetString("UNAME") ?? "Guest";
    userName = string.IsNullOrEmpty(userName) ? "Guest" : userName.ToUpper()+'-'+DateTime.Now.ToString("dd-MM-yyyy");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CBCID_APPLICATION</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/CBCID_APPLICATION.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/mystyle.css"> 
    <!-- Bootstrap Css -->
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.css" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="text/javascript" language="javascript">
        function DisableBackButton() {
         window.history.forward()
        }
        DisableBackButton();
         window.onload = DisableBackButton;
         window.onpageshow = function(evt) { if (evt.persisted) DisableBackButton() }
          window.onunload = function() { void (0) }
    </script>

</head>
<body>
    <div class="container-fluid container-scrollerx">
        <!-- partial:partials/_navbar.html -->
        <!-- partial -->
        <button id="toggleSidebar" class="navbar-toggler d-sm-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar" aria-controls="sidebar" aria-expanded="false" aria-label="Toggle navigation">

            <i class="fa fa-bars text-white" aria-hidden="true"></i>
        </button>
        <div class="row">
            <div id="toggleSidebar" class="col-12 col-lg-3 col-xl-2 p-0 sidebar sidebar-offcanvas ">
            <nav class="" id="sidebar">
                @*  <div class="navbar-brand-wrapper d-flex align-items-center justify-content-center text-center pt-3">
                    <a class="navbar-brandx brand-logox text-white TEXT-CENTER" href="dashboard.aspx"><h3><strong>CID</strong></h3></a>

                </div> *@
                <div class="user-profile">
                    <div class="user-image">
                        <img src="~/IMAGES/LOGO.jpeg">
                    </div>
                    @* 
                    <div class="user-name">
                        C.I.D
                    </div> 
                    *@
                    <div class="user-designation">
                        Crime Investigation Department
                    </div>
                   <div class="small mt-3">Welcome To User <br/> @userName </div>
                </div>
                <ul class="nav">
                    <li class="nav-item">
                        <a class="nav-link" href="../DashBoard/Index">
                            <i class="fa fa-2x fa-home mr-2"></i>
                            <span class="menu-title">Dashboard</span>
                            <span></span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" data-toggle="collapse" href="#auth" aria-expanded="false" aria-controls="auth">
                            <i class="fa fa-2x fa-exchange mr-2"></i>
                            <span class="menu-title">Reports</span>

                        </a>
                        <div class="collapse" id="auth">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"> <a class="nav-link" href="#">प्रारूप -1 (क)</a></li>

                            </ul>
                        </div>
                    </li>



                    <li class="nav-item">
                        <a class="nav-link" href="../Password/UpdatePassword">
                            <i class="fa fa-2x fa-lock mr-2"></i>
                            <span class="menu-title">Password</span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="../Home/Index">
                            <i class="fa fa-2x fa-sign-out mr-2"></i>
                            <span class="menu-title">Logout</span>
                        </a>
                    </li>

                </ul>

            </nav>
            </div>
            <div class="col-12 col-lg-9 col-xl-10 p-0 ">
                <h4 class="mb-2 text-white bg-primary p-3 text-center">
                    <span class="font-weight-bold text-white">CID e-Reporting Portal</span>
                </h4>
                <div class="container-fluid  mt-50x  mb-100">
                    <div class="col-sm-12 mb-4  text-center mb-3 ">
                    </div>
                    <!-- partial -->
                    @RenderBody()
                </div>
            </div>
        </div>
        <!-- partial:footer -->
        <footer class="footer sec">
            <div class="text-center rel">
                <span class="text-muted d-block text-center text-sm-left d-sm-inline-block"><strong>Powered by <a href="https://tispl.net.in/" target="_blank"><img style="max-width:45px;" src="~/images/footer-logo.png" /> TRINETRADHAR INFO SOLUTION PVT. LTD</a></strong></span>
            </div>
        </footer>
        <!-- partial -->
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/dash/vendors/base/vendor.bundle.base.js"></script>
    <script src="~/Content/assets/js/vendor.bundle.js"></script>
    <script src="~/Content/assets/js/app.bundle.js"></script>
    <script src="~/Scripts/Custom.js"></script>
    <script>
        $(document).ready(function () {
            var sessionTimeout = 20 * 60 * 1000; // session time
            var warningTime = 18 * 60 * 1000;    // Warn time
            setTimeout(function () {
                alert("Your session is about to expire in 1 minute!");
            }, warningTime);
            setTimeout(function () {
                window.location.href = '/Home/Index';
            }, sessionTimeout);
        });
    </script>
    <script>
        $(document)
            .ajaxStart(function () {
                $('#AjaxLoader').show();
            })
            .ajaxStop(function () {
                $('#AjaxLoader').hide();
            });
    </script>
    <script>
        const container = document.getElementById("productsTable");
        function scrollLeft() {
            container.scrollBy({ right: -400, behavior: "smooth" });
        }
        function scrollRight() {
            container.scrollBy({ left: 2800, behavior: "smooth" });
        }
    </script>
    <script>
        (function () {
            history.pushState(null, "", location.href);
            window.addEventListener("popstate", function (event) {
                history.pushState(null, "", location.href);
                alert("Back/Forward navigation is disabled on this page.");
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar = document.querySelector(".sidebar-offcanvas");
            const toggleBtn = document.querySelector("#toggleSidebar");

            toggleBtn.addEventListener("click", function () {
                if (sidebar.style.right === "0px") {
                    sidebar.style.right = "-340px";
                } else {
                    sidebar.style.right = "0px";
                }
            });
        });
    </script>


    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.js"></script>
    @*  Calendender code *@
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
