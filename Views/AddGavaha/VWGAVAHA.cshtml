@model CBCID_APPLICATION.Models.Gavaha;
@using CBCID_APPLICATION.Models;
@{

    ViewData["Title"] = "VWFmt";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
    List<CBCID_APPLICATION.Models.Gavaha> RST = ViewBag.GavaLst;
    int i = 1;
}
<div class="row">
    <div class="col-md-2 p-b-20 pb-3">
       @*  <a class="btn btn-outline-warningg btn-info" href="~/Formatone/VWFmt"><i class="fa fa-arrow-left"></i></a> *@
        @if (Model.DCFCID != 0)
        {
            <a href="/Formatone/FmtInsertUpdate?DCFCID=@(Model.DCFCID.ToString())" class="btn btn-outline-warningg btn-info"><i class="fa fa-arrow-left"></i></a>
        }
    </div>
    <div class="col-md-8   text-center">
        <h4 class="page-title text-bold"><strong class="title-box">साक्षी का विवरण </strong></h4>
    </div>
    <div class="col-md-12 text-center ">
        <div class="card p-3 mt-2">
            <div class="table-responsive  m-b-0">
                <table id="productsTable" class="table text-center  table-hover table-bordered text-center p-m-0" style="table-layout: auto; over-flow: break-word; display:inline-table;">
                    <thead>
                        <tr class="text-center text-bold bg-tr">
                            <th class="bg-tr" align="center">क्र० सं० </th>
                            <th align="center">साक्षी का  नाम  </th>
                            <th align="center">साक्षी का प्रकार </th>
                            <th align="center">परीक्षण स्थिति </th>
                            @* <th align="center">परीक्षण तिथि </th> *@
                           @*  <th align="center">साक्षी की अग्रिम तिथि </th> *@
                            <th align="center">पता</th>
                            <th align="center">आधार</th>
                            <th align="center">फोन नंबर </th>
                            <th align="center">टिप्पणी </th>
                            <th align="center">अपडेट</th>
                        </tr>
                        @foreach (var RS in RST)
                        {
                            <tr>
                                <td align="center">@i</td>
                                <td align="center">@RS.GavahaName</td>
                                <td align="center">
                                    @if(RS.GavaTypeId==1)
                                    {
                                        <span>वीडियो कॉन्फ्रेंसिंग</span>
                                    }
                                    @if (RS.GavaTypeId == 2)
                                    {
                                        <span>न्यायालय में आकर</span>
                                    }
                                    @if (RS.GavaTypeId == 3)
                                    {
                                        <span>गवाह अनुपस्थित</span>
                                    }
                                </td>
                                <td align="center">
                                    @if(RS.Examined==1)
                                    {
                                        <span>परीक्षित</span>
                                    }
                                    @if (RS.Examined == 0)
                                    {
                                        <span>अपरीक्षित</span>
                                    }
                                </td>
                               @*  <td align="center">@(RS.Examineddate != null ? RS.Examineddate.Value.ToString("dd-MM-yyyy") : "उपलब्ध नहीं है")</td> *@
                                @* <td align="center">@(RS.GhavahiNextdate != null ? RS.GhavahiNextdate.Value.ToString("dd-MM-yyyy") : "उपलब्ध नहीं है")</td> *@
                                <td align="center">@(RS.Address != null ? RS.Address.ToString() : "उपलब्ध नहीं है")</td>
                                <td align="center">@(RS.AdharNo != null ? RS.AdharNo.ToString() : "उपलब्ध नहीं है")</td>
                                <td align="center">@(RS.Phoneno != null ? RS.Phoneno.ToString() : "उपलब्ध नहीं है")</td>
                                <td align="center">@(RS.Remark != null ? RS.Remark.ToString() : "उपलब्ध नहीं है")</td>
                                <td>
                                    @if (@RS.DCFCID != 0)
                                    {
                                        <a href="/AddGavaha/INSERTUPDATEGAVAHA?DCFCID=@(RS.DCFCID.ToString())&gavahaid=@(RS.GavahaId.ToString())" class="xbtn xbtn-primary text-success"><i class="fa fa-edit"></i> </a>
                                    }
                                </td>
                            </tr>
                            i = i + 1;
                        }
                </table>
            </div>
        </div>
    </div>
    <div class="row">
    @if (Model.DCFCID > 0)
    {
        <a class="btn btn-outline-warningg btn-info" href="/Formatone/FmtInsertUpdate?DCFCID=@(Model.DCFCID.ToString())"><i class="fa fa-arrow-left"></i>back to main </a>
    }
    </div>
</div>
