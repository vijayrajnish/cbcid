@model CBCID_APPLICATION.Models.Utility_Users;
@using CBCID_APPLICATION.Models;
@{
    ViewData["Title"] = "VWFmt";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}
<div class="row">
    <div class="col-md-12 text-center pb-3">
        <h4 class="page-title text-bold"><strong class="title-box">Change Password</strong></h4>
    </div>
</div>
<div class="card p-3">
    <form asp-action="UpdatePassword" asp-controller="Password" method="post">
        <div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <input type="hidden" asp-for="EmployeeId" asp-action="UpdatePassword" />

            </div>
            <div class="row">
                <div class="col-md-4 col-sm-12">
                    <div class="form-group">
                        <label> UserName </label>
                        <input asp-for="UserName" type="text" class="form-control" readonly="readonly" placeholder="UserName" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="form-group">
                        <label>Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="form-group">
                        <label>Confirm Password</label>
                        <input class="form-control" type="password" name="pass1" id="pass1" placeholder="Confirm Password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group text-center">
                <input type="submit" id="btnsubmit" name="btnsubmit" value="Change Password" class="btn btn-primary" />
            </div>
        </div>
    </form>

</div>
