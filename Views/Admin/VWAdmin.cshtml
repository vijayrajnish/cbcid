@model CBCID_APPLICATION.Models.DET_CRIME_FEMALE_CHILDREN;
@using CBCID_APPLICATION.Models;
@{
    ViewData["Title"] = "VWFmt";
    //Layout = "~/Views/Shared/_Dashboard.cshtml";
    Layout = "~/Views/Shared/_AdminDashboard.cshtml";
    List<CBCID_APPLICATION.Models.VW_DET_CRIME_FEM_CHILD> RST = ViewBag.FmtLst;
    int i = 1;
}
 <style>
    .wrap-text {
        white-space: normal !important;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

    /* Optional: keep table layout fixed for better control */
    table {
        table-layout: fixed;
    }

    /* Optional: define max width for individual cells */
    .col-wide {
        min-width: 50px;
        max-width: 100px;
    }
</style>
<script src="https://code.jquery.com/jquery-3.6.3.js" integrity="sha256-nQLuAZGRRcILA+6dMBOvcRh5Pe310sBpanc6+QBmyVM=" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/gh/linways/table-to-excel@v1.0.4/dist/tableToExcel.js"></script>
<div class="row">
    
    <div class="col-md-12 text-center">
        <h4 class="page-title text-bold"><strong class="title-box">Admin Panel</strong></h4>
       
       
    </div>
    <div class="col-md-12 text-right p-b-20">
        <a class="btn btn-outline-warningg btn-info pull-left pb-2" href="~/Admin/ViewAdminDashBoard"><i class="fa fa-arrow-left"></i></a>
    </div>
    <br />
</div>
<div class="container-fluid">
    <form asp-action="VWAdmin" asp-controller="Admin" method="get">

        
        <div class="card card-primary bg-primary-gradient">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> संबंधित अपराधों का विवरण </label>
                            <select asp-for="FMTID" class="form-control" asp-items="@ViewBag.FMTID">
                                <option value="0">---संबंधित अपराधों का विवरण---</option>
                            </select>
                        </div>
                    </div>
                     <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> खण्ड </label>
                            <select asp-for="SECTORID" class="form-control" asp-items="@ViewBag.SECID">
                                <option value="0">---Select Sector---</option>
                                <option value="9">CIS kHAND</option>
                            </select>
                        </div>
                    </div> 
                    <div class="col-md-3 col-xl-3">
                        <div class="form-group">
                            <label>अभियोग की स्थिति  </label>
                            <select asp-for="CaseStatusId" class="form-control" asp-items="@ViewBag.CaseStatusId">
                                <option value="0">---चुनें---</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> सी बी सं० </label>
                            <input class="form-control" type="text" name="SCBCID" id="SCBCID" placeholder="सी बी सं०" value="" />
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> जनपद </label>
                            <select asp-for="DISTRICTID" class="form-control" asp-items="@ViewBag.DistrictId">
                                <option value="0">---Select District---</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> Application Status </label>
                            <select asp-for="PSAVE" class="form-control">
                                <option value="0">---Select Status---</option>
                                <option value="2">Partial Save</option>
                                <option value="1">Final Save</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> User </label>
                            <select asp-for="CREATEDBY" class="form-control">
                                <option value="0">---All---</option>
                                <option value="2">Sector Wise</option>
                                <option value="3">CIS KHAND </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3  col-xxl-4">
                        <div class="form-group">
                            <label>  वर्ष से  </label>
                            <select asp-for="YEAR" class="form-control" asp-items="@ViewBag.YEAR">
                                <option selected disabled>---वर्ष ---</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3  col-xxl-4">
                        <div class="form-group">
                            <label> वर्ष तक  </label>
                            <select asp-for="APRADHYEAR" class="form-control" asp-items="@ViewBag.YEAR">
                                <option selected disabled>---वर्ष ---</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4 col-md-12">
                        <input type="button" value="Refresh" id="btnrefresh" name="btnrefresh" class="btn btn-primary btn-md " />
                        <button class="btn btn-primary btn-md pull-right" type="submit"><i class="fa fa-search"></i> खोजें</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>


<div class="">
    <button class="btn btn-sm bg-primary   text-center  shadow m-2 " id="btnExport" name="btnExport" type="button"><strong class="text-white"><i class="fa fa-download"></i> &nbsp; Download Excel </strong><div class="ripple-container"></div></button>
    <button class="btn btn-info mr-2" style="visibility:hidden;" onclick="scrollLeft()"><i class="fa fa-arrow-left"></i> Scroll Left &nbsp;</button>
</div>
<div class="row">
    @* <div class="col-md-12 text-right ">

    </div> *@
    <div class="col-md-12">
        <div class="card p-3">
            <div class=" card-data-tables product-table-wrapper m-t-0">
                <div class="card-body p-2">
                    <div id="scrollContainer" class="table-responsivex w-100 pt-20">
                        <button class="btn btn-danger text-white btn-sm pull-right m-2" onclick="scrollRight()">Scroll Right &nbsp;<i class="fa fa-arrow-right"></i></button>
                       @*  <table id="productsTable" name="productsTable" class="mdl-data-table product-table m-t-30 table-head-bg table-bordered" border="1" cellspacing="0" width="100%" style="width: 100%; max-height:500px; overflow: scroll; display: block;"> *@
                        <table id="productsTable" name="productsTable" class="mdl-data-table product-table m-t-30 table table-head-bg table-bordered" border="1" cellspacing="0" width="100%">
                            <thead class="table-head-border bg-tr  text-center">
                                <tr class="text-center text-bold bg-tr">
                                    <th class="table-head-bg wrap-text col-wide">क्र० सं० </th>
                                    <th class="table-head-bg wrap-text col-wide">एंट्री की स्थिति </th>
                                    <th class="table-head-bg wrap-text col-wide">संबंधित अपराध<br /> का प्रकार/जाँच का विषय </th>
                                    <th class="table-head-bg wrap-text col-wide">खण्ड</th>
                                    <th class="table-head-bg wrap-text col-wide">सी बी सं० </th>
                                    <th class="table-head-bg wrap-text col-wide">मु० अ० सं० </th>
                                    <th class="table-head-bg wrap-text col-wide">धारा </th>
                                    <th class="table-head-bg wrap-text col-wide">मुकदमें की स्थिति</th>
                                    <th class="table-head-bg wrap-text col-wide">अभ्युक्त के विरुद्ध जारी आदेश</th>
                                    <th class="table-head-bg wrap-text col-wide">थाना</th>
                                    <th class="table-head-bg wrap-text col-wide">अपराधी का नाम </th>
                                    <th class="table-head-bg wrap-text col-wide">आरोप पत्र न्यायलय<br /> में दाखिल करने की तिथि </th>
                                    <th class="table-head-bg wrap-text col-wide">आरोप पत्र <br />प्रसंज्ञान की तिथि</th>
                                    <th class="table-head-bg wrap-text col-wide">न्याया० का नाम /  सी एन आर</th>
                                    <th class="table-head-bg wrap-text col-wide">सुनवाई की अगली तिथि</th>
                                    <th class="table-head-bg wrap-text col-wide">साक्षी काउंट</th>
                                    <th class="table-head-bg wrap-text col-wide">अभियुक्त काउंट</th>
                                    <th class="table-head-bg wrap-text col-wide">देखें</th>

                                </tr>
                            </thead>


                            @foreach (var RS in RST)
                            {
                                <tr class="Data  text-center">
                                    <td class="wrap-text">@i</td>
                                    <td class="wrap-text">
                                        @if (RS.PSAVE == "1")
                                        {
                                            <span class="badge badge-success">फाइनल सेव</span>
                                        }
                                        else if (RS.PSAVE == "2")
                                        {
                                            <span class="badge badge-danger">पार्शियल सेव</span>
                                        }
                                    </td>
                                    <td class="wrap-text">@RS.FmtName</td>
                                    <td class="wrap-text">@RS.Sname</td>
                                    <td class="wrap-text">@RS.cbcidno</td>
                                    <td class="wrap-text">@RS.APRADHNO</td>
                                    <td class="wrap-text">@RS.ACT</td>
                                    <td class="wrap-text">@RS.ADATHAN_STATUS</td>
                                    <td class="wrap-text">@RS.JARIADESH</td>
                                    <td class="wrap-text">@RS.THANA</td>
                                    <td class="wrap-text">@RS.BNAME</td>
                                    <td class="wrap-text">@RS.DAKILDATE</td>
                                    <td class="wrap-text">@RS.ARROPVICHARANTHITHI</td>
                                    <td class="wrap-text">@RS.COURT</td>

                                    <td class="wrap-text">@RS.NEXT_HEARING_DATE</td>
                                    <td class="wrap-text">@RS.GAVAHA_CNT</td>
                                    <td class="wrap-text">@RS.Sahayak_Abhiyukt_CNT</td>
                                     <td>
                                        @if (RS.DCFCID != 0)
                                        {
                                            <ul class="nav nav-pills nav-primary ico-size">
                                                @if (RS.DCFCID > 0)
                                                {
                                                    <li>
                                                        <a href="#" class="clsview" encid="@RS.DCFCID" data-toggle="modal" class="nav-link">View</a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </td> 

                                </tr>
                                i = i + 1;
                            }

                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="RequestModal" tabindex="-1" role="dialog" aria-labelledby="RequestModalLabel" aria-hidden="true">
    <div class="modal-dialog bigdata modal-xl" role="document">
        <div class="modal-content" style="box-shadow: 1px 5px 36px -3px rgba(0,0,0,0.75); -webkit-box-shadow: 1px 5px 36px -3px rgba(0,0,0,0.75); -moz-box-shadow: 1px 5px 36px -3px rgba(0,0,0,0.75); ">
            <div class="modal-content bg-white">
                <div class="modal-header ">
                    <h5 class="modal-title" id="RequestModalLabel">संबंधित अपराधों का विवरण   </h5>
                </div>
                <div class="modal-body" id="idModalBody">
                </div>
                <div class="modal-footer">
                    <button id='closeModal' type="button" class="btn btn-danger" data-bs-dismiss="modal">Close/बंद करे</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    <link href="https://cdn.datatables.net/1.10.16/css/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/1.5.1/css/buttons.dataTables.min.css" rel="stylesheet" />
    <script src="https://cdn.datatables.net/1.10.9/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.16/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.2.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/2.5.0/jszip.min.js"></script>
    <script src="https://cdn.rawgit.com/bpampuch/pdfmake/0.1.18/build/pdfmake.min.js"></script>
    <script src="https://cdn.rawgit.com/bpampuch/pdfmake/0.1.18/build/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.2.2/js/buttons.html5.min.js"></script>

    <script>

        $(document).ready(function () {

            $("#btnExport").click(function () {

                let table = $("#productsTable");
                TableToExcel.convert(table[0], {
                    name: `Appradh_ka_Vivaran.xlsx`,
                    sheet: {
                        name: 'Appradh'
                    }
                });
            });
            $("#btnrefresh").click(function () {
             window.location.href = "/Admin/VWAdmin";
        });

            $('.clsview').click(function (event) {
                event.preventDefault();
                $('#RequestModal').show();
                $("#idModalBody").html('');
                var id = $(this).attr("encid");
                $.ajax({
                    type: "GET",
                    url: "/Common/FetchFormatone",
                    data: { 'encid': id },
                    success: function (response) {

                        $("#idModalBody").html(response);
                        $(document).find('#RequestModal').modal("show");
                        $('#RequestModal').modal({
                            backdrop: 'static',
                            keyboard: false
                        })
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            });

            $("#SECTORID").on("change", function () {
            var ddldist = $("#DISTRICTID");
            var districtid = $(this).val();
            if (districtid == "") {
                alert('Select the Sector');
                return false;
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Common/FetchAdminDistrict",
                    data: ({ 'DistrictId': districtid }),
                    success: function (response) {
                        ddldist.empty().append('<option selected="selected" value="">Please select</option>');
                        $.each(response, function () {
                            ddldist.append($("<option></option>").val(this['districtId']).html(this['districtName']));
                        });
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            }
        });

            $("#DISTRICTID").on("change", function () {
            var ddlthana = $("#THANAID");
            var districtid = $(this).val();
            if (districtid == "") {
                alert('Select the District');
                return false;
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Common/FetchThana",
                    data: ({ 'DistrictId': districtid }),
                    success: function (response) {

                        ddlthana.empty().append('<option selected="selected" value="">Please select</option>');
                        $.each(response, function () {
                            ddlthana.append($("<option></option>").val(this['thanaid']).html(this['thananame']));
                        });
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            }
        });

        });
    </script>

}




