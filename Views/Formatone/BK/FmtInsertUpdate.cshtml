                    alert('Enter Act.');
                    return false;
                }
                var dkdt=$("#DAKILDATE").val();
                if(dkdt=="")
                {
                    alert('Enter Dakhil Date.');
                    return false;
                }
                var ctid=$("#COURTID").val();
                if(ctid=="")
                {
                    alert('Enter Court.');
                    return false;
                }
                var pname=$("#PSHAKSHI_NAME").val();
                if(pname=="")
                {
                    alert('Enter Court.');
                    return false;
                }
           });


