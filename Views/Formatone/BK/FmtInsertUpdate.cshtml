                if(cbno=="" || cbno=="0")
                {
                    alert('Enter CBCID NO.');
                    return false;
                }

                var apdh=$("#APRADHNO").val();
                if(apdh=="")
                {
                    alert('Enter Apradh NO.');
                    return false;
                }
                var act=$("#ACT").val();
                if(act=="")
