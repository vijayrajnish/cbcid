           $(".numeric").on("keypress", function (e) {
            if (e.which != 8 && e.which != 0 &&
                (e.which < 48 || e.which > 57)) {
                e.preventDefault();
            }
        });
        $("#CaseStatusId").on("change", function () {
                var caseid = parseInt($(this).val());

                if (caseid === 13) {

                $("#ABID").show();
            } else if (caseid !== 13) {

                $("#ABID").hide();
            }
          });


           $("#SECTORID").on("change", function () {
            var ddldist = $("#DISTRICTID");
            var districtid = $(this).val();
            if (districtid == "") {
                alert('Select the Sector');
                return false;
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Common/FetchDistrict",
                    data: ({ 'DistrictId': districtid }),
                    success: function (response) {
                        ddldist.empty().append('<option selected="selected" value="">Please select</option>');
                        $.each(response, function () {
                            ddldist.append($("<option></option>").val(this['districtId']).html(this['districtName']));
                        });
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            }
        });
            $("#DISTRICTID").on("change", function () {
