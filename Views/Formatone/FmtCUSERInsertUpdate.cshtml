@model CBCID_APPLICATION.Models.DET_CRIME_FEMALE_CHILDREN
@{
    ViewData["Title"] = "FmtInsertUpdate";
    Layout = "~/Views/Shared/_CUSRDashboard.cshtml";
}
<div class="row">
    <div class="col-md-2 p-b-20 pb-3">
        <a class="btn btn-outline-warningg btn-info" href="~/Formatone/CUSRVWFmt"><i class="fa fa-arrow-left"></i></a>
    </div>
    <div class="col-md-8 text-center">
        <h4 class="page-title text-bold"><strong class="title-box">CID से संबंधित अपराधों का पंजीकरण  </strong></h4>
    </div>
    <div class="col-md-2 text-right p-b-20 pb-3">
    </div>
</div>


<div class="card p-3">

    <form asp-action="FmtCUSERInsertUpdate" asp-controller="Formatone" method="post">
        <div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <input type="hidden" asp-for="DCFCID" asp-action="FmtInsertUpdate" />
                <input type="hidden" asp-for="UPDATEDBY" asp-action="FmtInsertUpdate" />
                <div class="row">
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label>केस के स्थानांतरण का प्रकार</label>
                            <select asp-for="TransferFrm" class="form-control">
                                <option selected disabled>---Select---</option>
                                <option value="1">Shasan</option>
                                <option value="2">Supreme Court</option>
                                <option value="3">High Court</option>
                                <option value="4">Other</option>
                                <option value="5">Direct</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label>संबंधित अपराधों का प्रकार चुने</label>
                            <select asp-for="FMTID" class="form-control" asp-items="@ViewBag.FMTID">
                                <option selected disabled>---चुने---</option>
                            </select>
                            <span asp-validation-for="FMTID" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> खण्ड </label>
                            <select asp-for="SECTORID" class="form-control" asp-items="@ViewBag.SECID">
                                <option selected disabled>---Select Sector---</option>
                            </select>
                            <span asp-validation-for="SECTORID" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> जनपद </label>
                            <select asp-for="DISTRICTID" class="form-control" asp-items="@ViewBag.Did">
                                <option selected disabled>---Select District---</option>
                            </select>
                            <span asp-validation-for="DISTRICTID" class="text-danger"></span>
                        </div>
                    </div>
                   
                </div>
            </div>

            <div class="row">
                <div class="col-md-2 col-sm-12">
                    <div class="form-group">
                        <label> थाना  </label>
                        <select asp-for="THANAID" class="form-control" asp-items="@ViewBag.THANAID">
                            <option selected disabled>---Select Thana---</option>
                        </select>
                        <span asp-validation-for="THANAID" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-2 col-sm-12">
                    <div class="form-group">
                        <label> सी० बी० सं० वर्ष </label>
                        <select asp-for="YEAR" class="form-control" asp-items="@ViewBag.YEAR">
                            <option selected disabled>---वर्ष ---</option>
                        </select>
                        <span asp-validation-for="YEAR" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-2 col-sm-12">
                    <div class="form-group">
                        <label> सी बी सं० </label>
                        <input asp-for="CBCID_NO" class="form-control" />
                        <span asp-validation-for="CBCID_NO" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-2 col-sm-12">
                    <div class="form-group">
                        <label> मु० अ० सं० वर्ष </label>
                        <select asp-for="APRADHYEAR" class="form-control" asp-items="@ViewBag.YEAR">
                            <option selected disabled>---वर्ष ---</option>
                        </select>
                        <span asp-validation-for="APRADHYEAR" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-2 col-sm-12">
                    <div class="form-group">
                        <label> मु० अ० सं० </label>
                        <input asp-for="APRADHNO" class="form-control" />
                        <span asp-validation-for="APRADHNO" class="text-danger"></span>
                    </div>
                </div>

            </div>



            <div class="row">
                <div class="col-md-3 col-sm-12">
                    <div class="form-group">
                        <label> बनाम(अपराधी का नाम)  </label>

                        <input asp-for="BNAME" class="form-control" placeholder="BNAME" />
                        <span asp-validation-for="BNAME" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-md-3 col-sm-12">
                    <div class="form-group">
                        <label> आरोप पत्र दाखिल करने की तिथि   </label>

                        <input asp-for="DAKILDATE" type="date" class="form-control datepicker" placeholder="FRMDATE (ex. DD/MM/YYYY)" />
                        <span asp-validation-for="DAKILDATE" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="form-group">
                        <label> आरोप पत्र विरचन की तिथि   </label>
                        <input asp-for="ARROPVICHARANTHITHI" type="date" class="form-control datepicker" placeholder="FRMDATE (ex. DD/MM/YYYY)" />
                        <span asp-validation-for="ARROPVICHARANTHITHI" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="form-group">
                        <label> न्याया० का नाम   </label>
                        <select asp-for="COURTID" class="form-control" asp-items="@ViewBag.CRTID">
                            <option selected disabled>---Select Court---</option>
                        </select>
                        <span asp-validation-for="COURTID" class="text-danger"></span>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-3 col-sm-12">
                    <div class="form-group">
                        <label> सी एन आर  </label>
                        <input asp-for="CNRNO" class="form-control" placeholder="CNRNO" />
                        <span asp-validation-for="CNRNO" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="form-group">
                        <label> राजपत्रित</label>
                        <select asp-for="GOVTOFFICER" class="form-control">
                            <option selected disabled>---Select---</option>
                            <option value="1">Yes</option>
                            <option value="2">No</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="form-group" id="pno" name="pno">
                        <label> पी. एन. ओ  </label>
                        <input asp-for="PLNO" class="form-control" placeholder="CNRNO" />
                        <span asp-validation-for="PLNO" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="form-group">
                        <label> धारा  </label>
                        <input asp-for="ACT" class="form-control" placeholder="CNRNO" />
                        <span asp-validation-for="ACT" class="text-danger"></span>
                    </div>
                </div>
            </div>


                <div class="row">
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                        <label> विवेचना अधिकारी का नाम  </label>

                            <input asp-for="PSHAKSHI_NAME" class="form-control" />
                            <span asp-validation-for="PSHAKSHI_NAME" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                        <label> विवेचना अधिकारी का फोन नंबर    </label>
                            <input asp-for="RSHAKSHI_NAME" class="form-control" />
                            <span asp-validation-for="RSHAKSHI_NAME" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                        <label> मुकदमे की अद्यतन  स्थिति</label>
                            <select asp-for="CaseStatusId" class="form-control" asp-items="@ViewBag.CaseStatusId">
                                <option selected disabled>---चुनें---</option>
                            </select>
                            <span asp-validation-for="CaseStatusId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-3 col-sm-12">
                        <div class="form-group">
                            <label> अभ्युक्ति    </label>

                            <input asp-for="ABHIYUKT" class="form-control" />
                            <span asp-validation-for="ABHIYUKT" class="text-danger"></span>
                        </div>
                    </div>
                </div>


          
            <div class="form-group text-center">
                @if (Model.DCFCID == 0)
                {
                    <input type="submit" id="btnsubmit" name="btnsubmit" value="Create Record" class="btn btn-primary" />
                }
                else
                {
                    <input type="submit" id="btnsubmit" name="btnsubmit" value="Update Selected Record" class="btn btn-primary" />
                }

            </div>
        </div>
    </form>

</div>
@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>

        $(document).ready(function () {
            $(window).on("load", function (e) {
            var stat=@ViewBag.msg;
            $("#PLNO").hide();
            $("#pno").hide();
            
            if(stat=="1")
            {
                alert('Recorded Successfully');
                window.location.href = "/Formatone/CUSRVWFmt";
                return false;
            }
            if(stat=="2")
            {
                alert('Recorded Updated Successfully');
                window.location.href = "/Formatone/CUSRVWFmt";
                return false;
            }
            var gvid=$("#GOVTOFFICER").val();
            if(gvid=="1")
            {
                $("#PLNO").show();
                $("#pno").show();
            }
            else
            {
                $("#PLNO").close();
                $("#pno").close();
            }
            });
            $(document).on("click", "#btnsubmit", function () {

                var fid=$("#FMTID").val();
                if(fid=="")
                {
                    alert('Select The Format');
                    return false;
                }
                var tfrm=$("#TransferFrm").val();
                if(tfrm=="")
                {
                    alert('Select The Transfer');
                    return false;
                }
                var endt=$("#EntryDate").val();
                if(endt=="")
                {
                    alert('Enter date');
                    return false;
                }
                var secid=$("#SECTORID").val();
                if(secid=="" || secid=="0")
                {
                    alert('Enter Sector');
                    return false;
                }
                var did=$("#DISTRICTID").val();
                if(did=="" || did=="0")
                {
                    alert('Enter District');
                    return false;
                }
                var tid=$("#THANAID").val();
                if(tid=="" || tid=="0")
                {
                    alert('Enter Thana');
                    return false;
                }
                var cbcidyr=$("#CBCID_NO").val();
                var cbno=$("#CBCID_NO").val();
                if(cbno=="" || cbno=="0")
                {
                    alert('Enter CID NO.');
                    return false;
                }

                var apdh=$("#APRADHNO").val();
                if(apdh=="")
                {
                    alert('Enter Apradh NO.');
                    return false;
                }
                var act=$("#ACT").val();
                if(act=="")
                {
                    alert('Enter Act.');
                    return false;
                }
                var dkdt=$("#DAKILDATE").val();
                if(dkdt=="")
                {
                    alert('Enter Dakhil Date.');
                    return false;
                }
                var ctid=$("#COURTID").val();
                if(ctid=="")
                {
                    alert('Enter Court.');
                    return false;
                }
                var crno=$("#CNRNO").val();
                if(crno=="")
                {
                    alert('Enter Crno.');
                    return false;
                }
                var apyr=$("#APRADHYEAR").val();
                if(apyr=="")
                {
                    alert('सी० बी० सं० वर्ष.');
                    return false;
                }


                var yr=$("#YEAR").val();
                if(yr=="")
                {
                    alert('select Appradh Year.');
                    return false;
                }
                var Gofficer=$("#GOVTOFFICER").val();
                if(Gofficer=="")
                {
                    alert('select Govertment Year.');
                    return false;
                }
                else
                {
                    var pno=$("#PLNO").val();
                    if(pno=="")
                    {
                        alert('पी. एन. ओ');
                        return false;
                    }
                }


           });

           $("#SECTORID").on("change", function () {
            var ddldist = $("#DISTRICTID");
            var districtid = $(this).val();
            if (districtid == "") {
                alert('Select the Sector');
                return false;
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Common/FetchDistrict",
                    data: ({ 'DistrictId': districtid }),
                    success: function (response) {
                        ddldist.empty().append('<option selected="selected" value="">Please select</option>');
                        $.each(response, function () {
                            ddldist.append($("<option></option>").val(this['districtId']).html(this['districtName']));
                        });
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            }
        });

            $("#DISTRICTID").on("change", function () {
            var ddlthana = $("#THANAID");
            var districtid = $(this).val();
            if (districtid == "") {
                alert('Select the District');
                return false;
            }
            else {
                $.ajax({
                    type: "POST",
                    url: "/Common/FetchThana",
                    data: ({ 'DistrictId': districtid }),
                    success: function (response) {

                        ddlthana.empty().append('<option selected="selected" value="">Please select</option>');
                        $.each(response, function () {
                            ddlthana.append($("<option></option>").val(this['thanaid']).html(this['thananame']));
                        });
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    },
                    error: function (response) {
                        alert(response.responseText);
                    }
                });
            }
        });

         $("#GOVTOFFICER").on("change", function () {
        var gid = $(this).val();
        if(gid=="1")
        {
            $("#pno").show();
             $("#PLNO").show();
             $("#PLNO").val('');
        }
        if(gid=="2")
        {
            $("#PLNO").hide();
            $("#pno").hide();
        }
        });

                 $("#CaseStatusId").on("change", function () {
                     $("#ABHIYUKT").val($(this).find("option:selected").text());
                    });


        });
    </script>

}


